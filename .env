# --- Mode Selection (ollama or enterprise) ---
LLM_PROVIDER=ollama

# ============================
#  Auth / JWT (Enterprise)
# ============================
SERVICE_ACCOUNT=""
SERVICE_ACCOUNT_PASS=""
AUTH_URL=""

# =====================================
#  Chat (Enterprise: Azure/OpenAI)
# =====================================
LLM_API_BASE=""
LLM_DEPLOYMENT_NAME=""
LLM_API_VERSION="2024-06-01"

# =====================================
#  Embeddings (Enterprise)
# =====================================
EMBEDDING_API_BASE=""
EMBEDDING_DEPLOYMENT_NAME=""
EMBEDDING_API_VERSION="2024-06-01"

# ============================
#  Vertex/Gemini (Enterprise)
# ============================
BASE_URL=""
CHAT_SUFFIX="genai/vertexai/gemini-2.5-pro/generateContent"

# ============================
#  Ollama (Local)
# ============================
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_CHAT_MODEL="llama3.2"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# ============================
#  App-level configuration
# ============================
CHROMA_PATH="./chroma_store"
COLLECTION_NAME="ai_usecases"
ENVIRONMENT="dev"
