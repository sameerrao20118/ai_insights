# MySQL Configuration for Docker
# Copy this to .env after starting Docker MySQL

# ===== Data Source =====
DATA_SOURCE=mysql

# ===== MySQL Connection (Docker defaults) =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_insights
MYSQL_USER=ai_user
MYSQL_PASSWORD=ai_password
MYSQL_TABLE=ai_usecases
MYSQL_SSL_ENABLED=false
MYSQL_CONNECTION_POOL_SIZE=5

# ===== Query Observability =====
ENABLE_SQL_LOGGING=true
SHOW_GENERATED_SQL=true
