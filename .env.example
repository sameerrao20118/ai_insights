# =====================================
# MODE SELECTION
# =====================================
# Set to 'enterprise' for corporate gateways OR 'ollama' for local development
LLM_PROVIDER=ollama

# =====================================
# ENTERPRISE AUTHENTICATION (Required if LLM_PROVIDER=enterprise)
# =====================================
SERVICE_ACCOUNT=""
SERVICE_ACCOUNT_PASS=""
AUTH_URL=""

# =====================================
# AZURE OPENAI - CHAT LLM (Required if LLM_PROVIDER=enterprise)
# =====================================
# Base URL should be WITHOUT the /openai/deployments/ part
# AzureChatOpenAI will construct the full path automatically
LLM_API_BASE=""
LLM_DEPLOYMENT_NAME=""
LLM_API_VERSION="2024-06-01"

# =====================================
# AZURE OPENAI - EMBEDDINGS (Required if LLM_PROVIDER=enterprise)
# =====================================
EMBEDDING_API_BASE=""
EMBEDDING_DEPLOYMENT_NAME=""
EMBEDDING_API_VERSION="2024-06-01"

# =====================================
# GEMINI/VERTEX AI (Optional for enterprise)
# =====================================
BASE_URL=""
CHAT_SUFFIX="genai/vertexai/gemini-2.5-pro/generateContent"

# =====================================
# OLLAMA SETTINGS (Required if LLM_PROVIDER=ollama)
# =====================================
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_CHAT_MODEL="llama3.2"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# =====================================
# APPLICATION SETTINGS (Always Required)
# =====================================
CHROMA_PATH="./chroma_store"
COLLECTION_NAME="ai_usecases"
ENVIRONMENT="dev"

# =====================================
# DATA SOURCE CONFIGURATION
# =====================================
# Options: 'excel' or 'mysql'
DATA_SOURCE=excel

# =====================================
# MYSQL CONFIGURATION (Required if DATA_SOURCE=mysql)
# =====================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_insights
MYSQL_USER=root
MYSQL_PASSWORD=""
MYSQL_TABLE=ai_usecases
MYSQL_SSL_ENABLED=false
MYSQL_CONNECTION_POOL_SIZE=5

# =====================================
# QUERY OBSERVABILITY
# =====================================
ENABLE_SQL_LOGGING=true
SHOW_GENERATED_SQL=true

